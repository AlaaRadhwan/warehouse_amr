<?xml version="1.0"?>

<robot name="warehouse_amr"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="amr_properties.xacro"/>
    <!-- ========================================================= -->
    <!-- Coordinate convention                                    -->
    <!-- x = forward                                               -->
    <!-- y = left                                                  -->
    <!-- z = up                                                    -->
    <!-- ========================================================= -->

    <xacro:arg name="use_sim" default="false"/>
    <xacro:arg name="controllers_file" default=""/>
    <!-- ===================== -->
    <!-- BASE FOOTPRINT        -->
    <!-- ===================== -->

    <link name="base_footprint"/>


    <!-- ===================== -->
    <!-- CHASSIS               -->
    <!-- ===================== -->

    <link name="base_link">

        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>

            <material name="chassis_gray">
                <color rgba="0.45 0.45 0.45 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${base_mass}"/>

            <!-- Temporary box inertia approximation -->
            <inertia
                ixx="${base_mass * (base_width*base_width + base_height*base_height) / 12.0}"
                iyy="${base_mass * (base_length*base_length + base_height*base_height) / 12.0}"
                izz="${base_mass * (base_length*base_length + base_width*base_width) / 12.0}"
                ixy="0.0"
                ixz="0.0"
                iyz="0.0"/>
        </inertial>

    </link>


    <joint name="base_footprint_joint" type="fixed">

        <parent link="base_footprint"/>
        <child link="base_link"/>

        <!-- Put chassis center above ground -->
        <origin
            xyz="0 0 ${ground_clearance + base_height/2.0}"
            rpy="0 0 0"/>

    </joint>


    <!-- ===================== -->
    <!-- LEFT DRIVE WHEEL      -->
    <!-- ===================== -->

    <link name="left_wheel_link">

        <visual>
            <origin rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="wheel_black">
                <color rgba="0.08 0.08 0.08 1.0"/>
            </material>
        </visual>

        <collision>
            <origin rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${wheel_mass}"/>

            <!-- Cylinder axis is along Y -->
            <inertia
                ixx="${wheel_mass * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
                iyy="${wheel_mass * wheel_radius*wheel_radius / 2.0}"
                izz="${wheel_mass * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
                ixy="0.0"
                ixz="0.0"
                iyz="0.0"/>        
                
        </inertial>

    </link>


    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin
            xyz="0 ${wheel_separation/2.0} ${wheel_radius - (ground_clearance + base_height/2.0)}"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ===================== -->
    <!-- RIGHT DRIVE WHEEL     -->
    <!-- ===================== -->

    <link name="right_wheel_link">

        <visual>
            <origin rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="wheel_black"/>
        </visual>

        <collision>
            <origin rpy="${pi/2} 0 0"/>

            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${wheel_mass}"/>

            <!-- Cylinder axis is along Y -->
            <inertia
                ixx="${wheel_mass * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
                iyy="${wheel_mass * wheel_radius*wheel_radius / 2.0}"
                izz="${wheel_mass * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
                ixy="0.0"
                ixz="0.0"
                iyz="0.0"/>        
                
        </inertial>

    </link>


    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin
            xyz="0 ${-wheel_separation/2.0} ${wheel_radius - (ground_clearance + base_height/2.0)}"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ========================================================= -->
    <!-- PASSIVE SUPPORT WHEELS                                   -->
    <!--                                                          -->
    <!-- For V0 these are only geometric placeholders.            -->
    <!-- Proper caster dynamics will be added during Gazebo work. -->
    <!-- ========================================================= -->

    <xacro:macro name="support_wheel" params="name x y">

        <link name="${name}_link">

            <visual>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>

                <material name="caster_dark">
                    <color rgba="0.15 0.15 0.15 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
            </collision>

            <inertial>
                <mass value="${caster_mass}"/>

                <inertia
                    ixx="${2.0/5.0 * caster_mass * caster_radius*caster_radius}"
                    iyy="${2.0/5.0 * caster_mass * caster_radius*caster_radius}"
                    izz="${2.0/5.0 * caster_mass * caster_radius*caster_radius}"
                    ixy="0.0"
                    ixz="0.0"
                    iyz="0.0"/>
            </inertial>

        </link>

        <joint name="${name}_joint" type="fixed">

            <parent link="base_link"/>
            <child link="${name}_link"/>

            <origin
                xyz="${x} ${y} ${caster_radius - (ground_clearance + base_height/2.0)}"
                rpy="0 0 0"/>

        </joint>

    </xacro:macro>


    <xacro:support_wheel
        name="front_left_support"
        x="${caster_x}"
        y="${caster_y}"/>

    <xacro:support_wheel
        name="front_right_support"
        x="${caster_x}"
        y="${-caster_y}"/>

    <xacro:support_wheel
        name="rear_left_support"
        x="${-caster_x}"
        y="${caster_y}"/>

    <xacro:support_wheel
        name="rear_right_support"
        x="${-caster_x}"
        y="${-caster_y}"/>

    <!-- ========================================================= -->
    <!-- SIMPLIFIED PASSIVE SUPPORT CONTACTS                       -->
    <!--                                                          -->
    <!-- V0 autonomy model: supports carry vertical load but       -->
    <!-- should not significantly resist planar motion / yaw.      -->
    <!-- ========================================================= -->

    <gazebo reference="front_left_support_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="front_right_support_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="rear_left_support_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="rear_right_support_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <!-- ========================================================= -->
    <!-- IMU FRAME                                                 -->
    <!-- ========================================================= -->

    <link name="imu_link"/>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>


    <!-- ========================================================= -->
    <!-- LIDAR FRAME                                               -->
    <!-- ========================================================= -->

    <link name="lidar_link">

        <visual>
            <geometry>
                <cylinder radius="0.035" length="0.05"/>
            </geometry>

            <material name="lidar_dark">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>

    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>

        <!-- provisional placement near front/top -->
        <origin
            xyz="0.35 0 ${base_height/2.0 + 0.04}"
            rpy="0 0 0"/>
    </joint>

    <xacro:if value="$(arg use_sim)">

        <!-- ===================================================== -->
        <!-- ros2_control Gazebo hardware                         -->
        <!-- ===================================================== -->

        <ros2_control name="GazeboSimSystem" type="system">

            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <joint name="left_wheel_joint">

                <command_interface name="velocity">
                    <param name="min">-12.0</param>
                    <param name="max">12.0</param>
                </command_interface>

                <state_interface name="position"/>
                <state_interface name="velocity"/>

            </joint>

            <joint name="right_wheel_joint">

                <command_interface name="velocity">
                    <param name="min">-12.0</param>
                    <param name="max">12.0</param>
                </command_interface>

                <state_interface name="position"/>
                <state_interface name="velocity"/>

            </joint>

        </ros2_control>


        <!-- ===================================================== -->
        <!-- gz_ros2_control plugin                               -->
        <!-- ===================================================== -->

        <gazebo>

            <plugin
                filename="libgz_ros2_control-system.so"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">

                <parameters>$(arg controllers_file)</parameters>

            </plugin>

        </gazebo>


        <!-- ===================================================== -->
        <!-- IMU                                                  -->
        <!-- ===================================================== -->

        <gazebo reference="imu_link">

            <sensor name="imu_sensor" type="imu">

                <always_on>true</always_on>
                <update_rate>100</update_rate>

                <topic>/imu/data_raw</topic>
                <gz_frame_id>imu_link</gz_frame_id>

            </sensor>

        </gazebo>


        <!-- ===================================================== -->
        <!-- 2D GPU LIDAR                                         -->
        <!-- ===================================================== -->

        <gazebo reference="lidar_link">

            <sensor name="lidar_sensor" type="gpu_lidar">

                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>10</update_rate>

                <topic>/scan</topic>
                <gz_frame_id>lidar_link</gz_frame_id>

                <lidar>

                    <scan>
                        <horizontal>

                            <samples>720</samples>
                            <resolution>1</resolution>

                            <min_angle>-3.14159265</min_angle>
                            <max_angle>3.14159265</max_angle>

                        </horizontal>
                    </scan>

                    <range>
                        <min>0.05</min>
                        <max>20.0</max>
                        <resolution>0.01</resolution>
                    </range>

                </lidar>

            </sensor>

        </gazebo>

    </xacro:if>

</robot>