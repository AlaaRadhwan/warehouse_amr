<?xml version="1.0"?>

<sdf version="1.10">

    <model name="apriltag_station_a">

        <static>true</static>

        <link name="tag_link">

            <visual name="tag_visual">

                <geometry>

                    <plane>

                        <!-- Tag lies flat on the floor -->
                        <normal>0 0 1</normal>

                        <!--
                        Actual AprilTag edge is 0.18 m.
                        Board includes surrounding white quiet zone.
                        -->
                        <size>0.225 0.225</size>

                    </plane>

                </geometry>

                <material>

                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>

                    <pbr>

                        <metal>

                            <albedo_map>materials/textures/tag.png</albedo_map>

                            <roughness>1.0</roughness>
                            <metalness>0.0</metalness>

                        </metal>

                    </pbr>

                </material>

            </visual>

        </link>

    </model>

</sdf>
