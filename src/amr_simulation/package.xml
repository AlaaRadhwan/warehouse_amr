<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_simulation</name>
  <version>0.0.0</version>
  <description>Gazebo (gz-sim) warehouse worlds, an AprilTag station model, ROS-Gazebo bridge configuration and the simulation launch.</description>
  <maintainer email="alaa.radhwanmustafa@gmail.com">alaa-radhwan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_control</exec_depend>
  <exec_depend>amr_localization</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <exec_depend>xacro</exec_depend>
  
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
