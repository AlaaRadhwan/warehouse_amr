# Experiment limits (sourced by scripts/run_experiment.sh). Observation settings only; no Nav2 parameter appears here.
: "${SIM_LIMIT:=120}"        # sim-seconds after goal acceptance (observed successes finished in 40-60 sim-s)
: "${WALL_LIMIT:=330}"       # wall-clock safety limit for the goal (s); at RTF~0.57 the sim limit alone needs ~210 s
: "${POST_TRIGGER:=10}"      # sim-s of extra recording after the online watchdog first fires, then the goal is cancelled
: "${SETTLE_S:=10}"          # wall-s to wait after readiness before recording / sending the goal
: "${MIN_FREE_GB:=3}"        # abort if /home has less than this free
