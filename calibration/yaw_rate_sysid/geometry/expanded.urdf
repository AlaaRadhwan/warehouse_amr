    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.005416666666666668" ixy="0.0" ixz="0.0" iyy="0.010000000000000002" iyz="0.0" izz="0.005416666666666668"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 -0.34500000000000003 -0.06"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- ========================================================= -->
  <!-- PASSIVE SUPPORT WHEELS                                   -->
  <!-- ========================================================= -->
  <link name="front_left_support_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.12 0.12 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00032" ixy="0.0" ixz="0.0" iyy="0.00032" iyz="0.0" izz="0.00032"/>
    </inertial>
  </link>
  <joint name="front_left_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_support_link"/>
    <origin rpy="0 0 0" xyz="0.4 0.24 -0.12"/>
  </joint>
  <link name="front_right_support_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.12 0.12 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00032" ixy="0.0" ixz="0.0" iyy="0.00032" iyz="0.0" izz="0.00032"/>
    </inertial>
  </link>
  <joint name="front_right_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_support_link"/>
    <origin rpy="0 0 0" xyz="0.4 -0.24 -0.12"/>
  </joint>
  <link name="rear_left_support_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.12 0.12 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00032" ixy="0.0" ixz="0.0" iyy="0.00032" iyz="0.0" izz="0.00032"/>
    </inertial>
  </link>
  <joint name="rear_left_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_support_link"/>
    <origin rpy="0 0 0" xyz="-0.4 0.24 -0.12"/>
  </joint>
  <link name="rear_right_support_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.12 0.12 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00032" ixy="0.0" ixz="0.0" iyy="0.00032" iyz="0.0" izz="0.00032"/>
    </inertial>
  </link>
  <joint name="rear_right_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_support_link"/>
    <origin rpy="0 0 0" xyz="-0.4 -0.24 -0.12"/>
  </joint>
  <!-- Simplified low-friction support contacts retained from V0 -->
  <gazebo reference="front_left_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="front_right_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_left_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_right_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <!-- ========================================================= -->
  <!-- IMU FRAME                                                -->
  <!-- ========================================================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <!-- ========================================================= -->
  <!-- LIDAR + PEDESTAL                                         -->
  <!--                                                          -->
  <!-- TF location is intentionally unchanged from V0.           -->
  <!-- ========================================================= -->
  <link name="lidar_link">
    <!-- Pedestal -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.065"/>
      <geometry>
        <cylinder length="0.08" radius="0.025"/>
      </geometry>
      <material name="lidar_pedestal">
        <color rgba="0.18 0.20 0.22 1.0"/>
      </material>
    </visual>
    <!-- LiDAR puck -->
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.040"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Existing verified transform retained -->
    <origin rpy="0 0 0" xyz="0.35 0 0.14"/>
  </joint>
  <!-- ========================================================= -->
  <!-- DOCKING CAMERA                                           -->
  <!--                                                          -->
  <!-- Reference hardware envelope:                              -->
  <!-- Raspberry Pi Global Shutter Camera (IMX296) + C/CS lens. -->
  <!-- Optical center is ~0.24 m above the floor and the camera  -->
  <!-- is pitched 25 degrees downward for floor fiducials.       -->
  <!-- ========================================================= -->
  <link name="camera_mount_link">
    <!-- Protective camera housing -->
    <visual>
      <geometry>
        <box size="0.07 0.06 0.06"/>
      </geometry>
      <material name="camera_housing_black">
        <color rgba="0.035 0.035 0.04 1.0"/>
      </material>
    </visual>
    <!-- Front lens barrel, approximate only -->
    <visual>
      <origin rpy="0 1.5707963267948966 0" xyz="0.047 0 0"/>
      <geometry>
        <cylinder length="0.024" radius="0.018"/>
      </geometry>
      <material name="camera_lens">
        <color rgba="0.02 0.02 0.025 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin rpy="0 0.4363323129985824 0" xyz="0.43 0.0 0.08"/>
  </joint>
  <!-- Conventional robot camera frame: x forward, y left, z up -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <!-- Approximate optical center near the front of the housing -->
    <origin rpy="0 0 0" xyz="0.035 0 0"/>
  </joint>
  <!-- REP-103 optical frame: x right, y down, z forward -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ========================================================= -->
  <!-- SIMULATION-ONLY COMPONENTS                               -->
  <!-- ========================================================= -->
  <!-- ===================================================== -->
  <!-- ros2_control Gazebo hardware                         -->
  <!-- ===================================================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- ===================================================== -->
  <!-- gz_ros2_control plugin                               -->
  <!-- ===================================================== -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/alaa-radhwan/Projects/warehouse_amr/src/amr_control/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- ===================================================== -->
  <!-- IMU                                                  -->
  <!-- ===================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- ===================================================== -->
  <!-- 2D GPU LIDAR                                         -->
  <!-- ===================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ===================================================== -->
  <!-- DOCKING CAMERA                                       -->
  <!--                                                     -->
  <!-- Approximate Raspberry Pi Global Shutter Camera       -->
  <!-- geometry with provisional 6 mm lens (~45.4 deg HFOV).-->
  <!-- A ros_gz_bridge image + camera_info bridge will be   -->
  <!-- added when AprilTag simulation is introduced.        -->
  <!-- ===================================================== -->
  <gazebo reference="camera_link">
    <sensor name="docking_camera_sensor" type="camera">
      <always_on>false</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>0.7924</horizontal_fov>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
