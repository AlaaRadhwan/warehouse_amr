  <!-- ========================================================= -->
  <!-- ========================================================= -->
  <!-- Coordinate convention                                     -->
  <!-- x = forward, y = left, z = up                             -->
  <!-- ========================================================= -->
  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT                                            -->
  <!-- ========================================================= -->
  <link name="base_footprint"/>
  <!-- ========================================================= -->
  <!-- MAIN CHASSIS                                              -->
  <!--                                                          -->
  <!-- IMPORTANT:                                                -->
  <!-- The collision and inertial model intentionally remain     -->
  <!-- equivalent to the previous V0 chassis so the working      -->
  <!-- navigation / drivetrain baseline is not changed by this   -->
  <!-- visual redesign.                                          -->
  <!-- ========================================================= -->
  <link name="base_link">
    <!-- Lower equipment enclosure -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.03"/>
      <geometry>
        <box size="0.96 0.56 0.14"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.08 0.20 0.32 1.0"/>
      </material>
    </visual>
    <!-- Raised payload deck -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.05 0 0.1225"/>
      <geometry>
        <box size="0.82 0.54 0.045"/>
      </geometry>
      <material name="deck_dark">
        <color rgba="0.10 0.11 0.12 1.0"/>
      </material>
    </visual>
    <!-- Front sensor nose -->
    <visual>
      <origin rpy="0 0 0" xyz="0.425 0 0.07"/>
      <geometry>
        <box size="0.11 0.5 0.08"/>
      </geometry>
      <material name="sensor_nose_dark">
        <color rgba="0.05 0.07 0.09 1.0"/>
      </material>
    </visual>
    <!-- Left side protection rail / fairing -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.03 0.2875 0.015"/>
      <geometry>
        <box size="0.76 0.025 0.075"/>
      </geometry>
      <material name="side_rail_gray">
        <color rgba="0.24 0.27 0.30 1.0"/>
      </material>
    </visual>
    <!-- Right side protection rail / fairing -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.03 -0.2875 0.015"/>
      <geometry>
        <box size="0.76 0.025 0.075"/>
      </geometry>
      <material name="side_rail_gray"/>
    </visual>
    <!-- Front safety bumper -->
    <visual>
      <origin rpy="0 0 0" xyz="0.4875 0 -0.005"/>
      <geometry>
        <box size="0.025 0.58 0.055"/>
      </geometry>
      <material name="safety_orange">
        <color rgba="0.95 0.35 0.05 1.0"/>
      </material>
    </visual>
    <!-- Rear safety bumper -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.4875 0 -0.005"/>
      <geometry>
        <box size="0.025 0.58 0.055"/>
      </geometry>
      <material name="safety_orange"/>
    </visual>
    <!-- Existing conservative collision envelope -->
    <collision>
      <geometry>
        <box size="1.0 0.6 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <!-- Temporary box inertia approximation retained from V0 -->
      <inertia ixx="1.6666666666666667" ixy="0.0" ixz="0.0" iyy="4.333333333333333" iyz="0.0" izz="5.666666666666667"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.16"/>
  </joint>
  <!-- ========================================================= -->
  <!-- LEFT DRIVE WHEEL                                         -->
  <!-- ========================================================= -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.04 0.04 0.04 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.005416666666666668" ixy="0.0" ixz="0.0" iyy="0.010000000000000002" iyz="0.0" izz="0.005416666666666668"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 0.34500000000000003 -0.06"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- ========================================================= -->
  <!-- RIGHT DRIVE WHEEL                                        -->
  <!-- ========================================================= -->
  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
